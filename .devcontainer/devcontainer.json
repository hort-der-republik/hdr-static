{
	"build": { "dockerfile": "../docker/Dockerfile" },
	"remoteUser": "node",
	"postCreateCommand": "uv python install 3.13 && uv sync && pnpm install && pnpm exec playwright install",
	"forwardPorts": [5173],
	"customizations": {
		"vscode": {
			"extensions": [
				"bradlc.vscode-tailwindcss",
				"editorconfig.editorconfig",
				"ms-playwright.playwright",
				"ms-python.python",
				"oxc.oxc-vscode",
				"redhat.java",
				"stylelint.vscode-stylelint"
			],
			"settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
		}
	}
}
