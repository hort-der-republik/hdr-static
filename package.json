{
	"name": "hdr-static",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"images": "node ./tsscripts/utils/images.ts",
		"serve": "python -m http.server 8000 -d html",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "oxlint --type-aware --type-check",
