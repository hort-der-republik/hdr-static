		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.137",
		"@iconify-json/simple-icons": "^1.2.98",
		"@iconify/tailwind4": "^1.2.3"
	},
	"devDependencies": {
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"sharp": "^0.35.5",
		"stylelint": "^17.15.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.1"
	},
	"engines": {
		"node": "24.x"
	}
